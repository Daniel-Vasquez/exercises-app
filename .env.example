# ==============================================================================
#  COACH APP — Variables de entorno
# ==============================================================================
#  Copia este archivo a `.env` y rellena los valores reales:
#      cp .env.example .env
#
#  ⚠️  `.env` NUNCA se commitea (está en .gitignore). Este archivo `.env.example`
#      SÍ se commitea, pero solo con valores de ejemplo — jamás con secretos reales.
#
#  Convención de Astro:
#    · Las variables con prefijo `PUBLIC_` se inyectan en el bundle del NAVEGADOR.
#      Cualquier usuario puede leerlas. Nunca pongas un secreto detrás de `PUBLIC_`.
#    · Las variables SIN prefijo solo existen en el servidor.
#
#  La columna [Tanda] indica en qué tanda de `planificacion.md` se vuelve necesaria.
# ==============================================================================


# ------------------------------------------------------------------------------
#  1. ENTORNO Y SERVIDOR                                              [Tanda 0]
# ------------------------------------------------------------------------------

# Entorno de ejecución. Afecta a logs y a los flags de seguridad de la cookie.
# Valores: development | production
NODE_ENV=development

# Puerto del servidor Astro. 4321 es el valor por defecto de Astro.
PORT=4321

# URL pública desde la que se sirve la app.
# Se usa para construir URLs absolutas (callbacks, og:image, enlaces de correo).
# En producción debe ser el dominio real CON https, y SIN barra final.
#   dev  → http://localhost:4321
#   prod → https://tu-dominio.com
PUBLIC_SITE_URL=http://localhost:4321


# ------------------------------------------------------------------------------
#  2. BASE DE DATOS — MongoDB                                         [Tanda 1]
# ------------------------------------------------------------------------------
#  Guarda TODO: usuarios y sesiones (Better Auth), perfiles, rutinas, registros
#  de entrenamiento y el catálogo local de ejercicios sincronizado.
#
#  Cómo obtenerla:
#    1. Crea un cluster gratuito (M0) en https://cloud.mongodb.com
#    2. Database Access → crea un usuario de base de datos con contraseña
#    3. Network Access  → añade tu IP  (y 0.0.0.0/0 si despliegas en serverless)
#    4. Connect → Drivers → copia la cadena de conexión
#
#  ⚠️  Si la contraseña tiene caracteres especiales (@ : / ? # [ ] %), debe ir
#      URL-encoded. Ejemplo:  p@ss:w0rd  →  p%40ss%3Aw0rd
# ------------------------------------------------------------------------------

# Cadena de conexión completa. SECRETO.
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos dentro del cluster.
# Se crea sola en la primera escritura; no hace falta crearla a mano.
# Usa un nombre distinto para desarrollo y producción (ej. coach_app_dev / coach_app).
MONGODB_DB_NAME=coach_app_dev


# ------------------------------------------------------------------------------
#  3. AUTENTICACIÓN — Better Auth                                     [Tanda 1]
# ------------------------------------------------------------------------------
#  Registro y login simples con nombre, correo y contraseña.
#  Sin verificación de correo y sin recuperación de contraseña (según la spec),
#  por eso NO hay variables de SMTP ni de proveedor de email en este archivo.
# ------------------------------------------------------------------------------

# Clave con la que se firman y cifran las sesiones. SECRETO CRÍTICO.
# Genérala con:
#     openssl rand -base64 32
#
# ⚠️  Cambiar este valor invalida TODAS las sesiones activas (todos deberán
#     volver a iniciar sesión). Usa valores DISTINTOS en desarrollo y producción,
#     y no la reutilices entre proyectos.
BETTER_AUTH_SECRET=reemplaza_esto_con_el_resultado_de_openssl_rand_base64_32

# URL base donde vive el handler de autenticación (`/api/auth/*`).
# Debe coincidir EXACTAMENTE con el origen desde el que se sirve la app
# (mismo protocolo, host y puerto), o las cookies de sesión serán rechazadas.
# Es la causa nº 1 de "el login parece funcionar pero la sesión no persiste".
#   dev  → http://localhost:4321
#   prod → https://tu-dominio.com
BETTER_AUTH_URL=http://localhost:4321

# Duración de la sesión en segundos.  604800 = 7 días.
# Para una app de entrenamiento conviene una sesión larga: nadie quiere
# volver a iniciar sesión en el gimnasio con las manos llenas.
#   604800  =  7 días
#   2592000 = 30 días  (recomendado en producción)
SESSION_MAX_AGE=604800


# ------------------------------------------------------------------------------
#  4. API DE EJERCICIOS (fuente de datos externa)                     [Tanda 2]
# ------------------------------------------------------------------------------
#  Catálogo público de 1.324 ejercicios. NO requiere clave de API.
#
#  Esta API se consume ÚNICAMENTE desde los scripts de sincronización
#  (`npm run sync:exercises`), nunca durante una petición de usuario — ver
#  ADR-01 en planificacion.md. Tras el sync, la app funciona aunque la API
#  esté caída o su cluster gratuito esté pausado.
# ------------------------------------------------------------------------------

# URL base de la API, SIN barra final.
# Dominio alternativo equivalente: https://exercises-dataset.danielvasquez.lat/api/v1
PUBLIC_EXERCISES_API_URL=https://exercises-dataset-rho.vercel.app/api/v1

# Timeout por petición, en milisegundos.
# Generoso a propósito: la API corre en funciones serverless y el primer
# request tras un periodo de inactividad sufre cold start.
EXERCISES_API_TIMEOUT_MS=15000

# Reintentos ante fallo de red o 5xx, con backoff exponencial.
EXERCISES_API_RETRIES=3

# Ejercicios por página al sincronizar. Máximo permitido por la API: 100.
# Con 100 → 14 peticiones para los 1.324 ejercicios.
EXERCISES_SYNC_PAGE_SIZE=100


# ------------------------------------------------------------------------------
#  5. MOTOR DE RUTINAS                                                [Tanda 4]
# ------------------------------------------------------------------------------

# Sal (salt) para la semilla del generador determinista de rutinas.
# La semilla final es:  sha256(SALT + userId + coachId + cuestionario + versión)
#
# Su función: dos usuarios con respuestas idénticas reciben rutinas DISTINTAS,
# mientras que un mismo usuario recibe siempre la MISMA rutina (reproducible).
#
# ⚠️  Cambiar este valor altera las rutinas que se generen a partir de ese
#     momento. Las rutinas ya guardadas no se modifican (la semilla queda
#     almacenada en cada documento de rutina). Fíjalo una vez y no lo toques.
# Genérala con:  openssl rand -hex 16
ROUTINE_SEED_SALT=cambia_esta_cadena_por_una_propia

# Versión del motor de rutinas. Increméntala cuando cambien las reglas de
# generación y quieras que los usuarios puedan regenerar con la nueva lógica.
ROUTINE_ENGINE_VERSION=1


# ------------------------------------------------------------------------------
#  6. OBSERVABILIDAD Y LÍMITES                                        [Tanda 9]
# ------------------------------------------------------------------------------

# Nivel de detalle de los logs del servidor.
# Valores: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting de los endpoints sensibles (login, registro, generar rutina).
# Ventana en segundos y número máximo de peticiones por IP dentro de la ventana.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20


# ==============================================================================
#  CHECKLIST RÁPIDA POR TANDA
# ==============================================================================
#  Tanda 0 → NODE_ENV · PORT · PUBLIC_SITE_URL
#  Tanda 1 → MONGODB_URI · MONGODB_DB_NAME · BETTER_AUTH_SECRET
#            BETTER_AUTH_URL · SESSION_MAX_AGE
#  Tanda 2 → PUBLIC_EXERCISES_API_URL (+ opcionales de timeout/retries/page-size)
#  Tanda 4 → ROUTINE_SEED_SALT · ROUTINE_ENGINE_VERSION
#  Tanda 9 → LOG_LEVEL · RATE_LIMIT_* · y repetir TODAS las anteriores en el
#            entorno de producción, con BETTER_AUTH_URL y PUBLIC_SITE_URL
#            apuntando al dominio real con https.
#
#  Los únicos SECRETOS reales de este archivo son:
#      MONGODB_URI · BETTER_AUTH_SECRET · ROUTINE_SEED_SALT
#  Ninguno lleva prefijo PUBLIC_, así que nunca llegan al navegador.
# ==============================================================================
