---
import Layout from '@/layouts/Layout.astro';
import { obtenerPerfil } from '@/lib/profiles/repository';
import { obtenerCoach } from '@/lib/coaches';
import { BODY_PARTS_ES } from '@/lib/i18n/body-parts.es';

// Tres estados: anónimo (landing), con sesión sin perfil (empuja al
// onboarding) y con perfil (resumen del plan). El dashboard completo, con
// el entreno de hoy y la racha, llega en la Tanda 8.
const usuario = Astro.locals.user;
const perfil = usuario ? await obtenerPerfil(usuario.id) : null;
const coach = perfil ? obtenerCoach(perfil.coachId) : null;

const split = coach && perfil ? coach.splitMatrix[perfil.questionnaire.diasPorSemana] : null;

const MATERIAL_ES: Record<string, string> = {
  casa_sin_equipo: 'En casa, sin equipo',
  casa_mancuernas: 'En casa, con mancuernas',
  gimnasio_basico: 'Gimnasio básico',
  gimnasio_completo: 'Gimnasio completo',
};
---

<Layout titulo="CoachApp — Tu entrenador personal">
  {
    !usuario && (
      <section class="py-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3 max-w-2xl">
          Una rutina hecha para ti, no para todos.
        </h1>
        <p class="text-lg max-w-2xl mb-6" style="color: var(--texto-suave);">
          Elige entre cuatro entrenadores con filosofías distintas, responde unas preguntas y
          recibe un plan construido sobre un catálogo de más de 1.300 ejercicios. Registra tus
          series y mira cómo progresas.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/registro"
            class="min-h-11 inline-flex items-center px-5 rounded-xl bg-acento-500 text-white font-medium hover:bg-acento-600 transition-colors"
          >
            Crear cuenta
          </a>
          <a
            href="/login"
            class="min-h-11 inline-flex items-center px-5 rounded-xl border font-medium transition-colors hover:border-acento-300"
            style="border-color: var(--borde);"
          >
            Entrar
          </a>
        </div>
      </section>
    )
  }

  {
    usuario && !perfil && (
      <section class="py-8">
        <h1 class="text-3xl font-bold tracking-tight mb-3">Hola, {usuario.name}.</h1>
        <p class="text-lg max-w-xl mb-6" style="color: var(--texto-suave);">
          Todavía no tienes un plan. Elige entrenador y responde unas preguntas: son dos minutos.
        </p>
        <a
          href="/onboarding"
          class="min-h-11 inline-flex items-center px-5 rounded-xl bg-acento-500 text-white font-medium hover:bg-acento-600 transition-colors"
        >
          Configurar mi plan
        </a>
      </section>
    )
  }

  {
    usuario && perfil && coach && (
      <section class="py-4">
        <h1 class="text-3xl font-bold tracking-tight mb-6">Hola, {usuario.name}.</h1>

        <article class="rounded-tarjeta border p-5 mb-6" style="border-color: var(--borde); background-color: var(--superficie-alt);">
          <div class="flex items-start gap-3">
            <span class="text-3xl leading-none" aria-hidden="true">{coach.emoji}</span>
            <div>
              <p class="font-semibold">
                {coach.nombre} <span style="color: var(--texto-suave);">«{coach.titulo}»</span>
              </p>
              <p class="text-sm italic mt-1" style="color: var(--texto-suave);">{coach.filosofia}</p>
            </div>
          </div>

          <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-2 mt-5 text-sm">
            <div class="flex justify-between gap-3 border-b pb-1" style="border-color: var(--borde);">
              <dt style="color: var(--texto-suave);">Frecuencia</dt>
              <dd class="tabular-nums">{perfil.questionnaire.diasPorSemana} días/semana</dd>
            </div>
            <div class="flex justify-between gap-3 border-b pb-1" style="border-color: var(--borde);">
              <dt style="color: var(--texto-suave);">Por sesión</dt>
              <dd class="tabular-nums">{perfil.questionnaire.minutosPorSesion} min</dd>
            </div>
            <div class="flex justify-between gap-3 border-b pb-1" style="border-color: var(--borde);">
              <dt style="color: var(--texto-suave);">Material</dt>
              <dd>{MATERIAL_ES[perfil.questionnaire.material]}</dd>
            </div>
            <div class="flex justify-between gap-3 border-b pb-1" style="border-color: var(--borde);">
              <dt style="color: var(--texto-suave);">Reparto</dt>
              <dd>{split?.nombre ?? '—'}</dd>
            </div>
          </dl>

          {
            perfil.questionnaire.zonasAEvitar.length > 0 && (
              <p class="text-sm mt-4" style="color: var(--texto-suave);">
                Evitando: {perfil.questionnaire.zonasAEvitar.join(', ')}.
              </p>
            )
          }

          <p class="text-sm mt-4 pt-4 border-t" style="border-color: var(--borde); color: var(--texto-suave);">
            <strong style="color: var(--texto);">Progresión:</strong> {coach.progresionTexto}
          </p>
        </article>

        {
          split && (
            <section class="mb-6">
              <h2 class="text-sm font-semibold uppercase tracking-wide mb-3" style="color: var(--texto-suave);">
                Tu semana
              </h2>
              <ul class="grid gap-2 sm:grid-cols-2">
                {split.dias.map((dia) => (
                  <li class="rounded-tarjeta border p-4" style="border-color: var(--borde);">
                    <p class="font-medium text-sm">{dia.etiqueta}</p>
                    <p class="text-xs mt-1" style="color: var(--texto-suave);">
                      {dia.foco.map((f) => BODY_PARTS_ES[f]).join(' · ')}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="flex flex-wrap gap-3">
          <a
            href="/rutina"
            class="min-h-11 inline-flex items-center px-5 rounded-xl bg-acento-500 text-white font-medium hover:bg-acento-600 transition-colors"
          >
            Ver mi rutina
          </a>
          <a
            href="/onboarding?editar=1"
            class="min-h-11 inline-flex items-center px-5 rounded-xl border font-medium transition-colors hover:border-acento-300"
            style="border-color: var(--borde);"
          >
            Ajustar plan
          </a>
        </div>

        <p class="text-sm mt-6" style="color: var(--texto-suave);">
          La rutina con ejercicios concretos se genera en la Tanda 4.
        </p>
      </section>
    )
  }
</Layout>
