---
import Layout from '@/layouts/Layout.astro';
import DiaEntreno from '@/components/react/DiaEntreno.tsx';
import { obtenerRutinaActiva } from '@/lib/routines/repository';
import { obtenerVarios } from '@/lib/exercises/repository';
import { obtenerCoach } from '@/lib/coaches';
import { obtenerRegistro, registrosEntreFechas, ultimosValores } from '@/lib/logs/repository';
import { fechaLocal } from '@/lib/progress/metrics';

const usuario = Astro.locals.user!;
const rutina = await obtenerRutinaActiva(usuario.id);
const coach = rutina ? obtenerCoach(rutina.coachId) : null;

// La fecha la propone el cliente (es local), pero el servidor necesita una
// para la primera pintada. Se usa la del servidor como punto de partida y
// una isla la corrige si la zona horaria del usuario difiere.
const hoy = Astro.url.searchParams.get('fecha') ?? fechaLocal();

/**
 * Día sugerido: el siguiente de la rotación.
 * Si ya hay registro de hoy se abre ese; si no, se avanza desde el último
 * día entrenado. Así la app no obliga a elegir cada vez, pero tampoco
 * impone: las pestañas permiten cambiar.
 */
let diaSugerido = 0;
if (rutina) {
  const pedido = Number(Astro.url.searchParams.get('dia') ?? NaN);
  if (Number.isInteger(pedido) && pedido >= 0 && pedido < rutina.dias.length) {
    diaSugerido = pedido;
  } else {
    const recientes = await registrosEntreFechas(usuario.id, restarDias(hoy, 14), hoy);
    const deHoy = recientes.find((r) => r.date === hoy);
    if (deHoy) {
      diaSugerido = deHoy.dayIndex;
    } else if (recientes.length) {
      diaSugerido = (recientes[0]!.dayIndex + 1) % rutina.dias.length;
    }
  }
}

const dia = rutina?.dias[diaSugerido] ?? null;

const ids = dia ? dia.bloques.map((b) => b.exerciseId) : [];
const ejercicios = await obtenerVarios([...new Set(ids)]);
const porId = new Map(ejercicios.map((e) => [e.id, e]));

const registro = dia ? await obtenerRegistro(usuario.id, hoy, diaSugerido) : null;
const sugerencias = dia ? await ultimosValores(usuario.id, ids) : {};

const bloques = (dia?.bloques ?? []).map((b) => {
  const e = porId.get(b.exerciseId);
  return {
    exerciseId: b.exerciseId,
    orden: b.orden,
    slotEtiqueta: b.slotEtiqueta,
    sets: b.sets,
    medida: b.medida ?? 'reps',
    repsMin: b.repsMin,
    repsMax: b.repsMax,
    segundos: b.segundos,
    restSeconds: b.restSeconds,
    nombre: e?.name_es ?? b.exerciseId,
    musculo: e?.target_es ?? '',
    equipo: e?.equipment_es ?? '',
    imagenUrl: e?.media?.image_url ?? '',
    gifUrl: e?.media?.gif_url ?? '',
    instrucciones: e?.instruction_steps ?? [],
  };
});

function restarDias(fecha: string, dias: number): string {
  const [y, m, d] = fecha.split('-').map(Number) as [number, number, number];
  const base = new Date(y, m - 1, d);
  base.setDate(base.getDate() - dias);
  return fechaLocal(base);
}

const fechaLegible = new Intl.DateTimeFormat('es', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
}).format(new Date(`${hoy}T12:00:00`));
---

<Layout titulo="Tu rutina — CoachApp">
  {
    !rutina && (
      <div class="py-16 text-center">
        <h1 class="text-2xl font-bold mb-2">Todavía no tienes rutina</h1>
        <p class="mb-6" style="color: var(--texto-suave);">
          Completa el cuestionario y la genero al instante.
        </p>
        <a
          href="/onboarding"
          class="min-h-11 inline-flex items-center px-5 rounded-xl bg-acento-500 text-white font-medium hover:bg-acento-600 transition-colors"
        >
          Configurar mi plan
        </a>
      </div>
    )
  }

  {
    rutina && dia && (
      <>
        <header class="mb-4">
          <p class="text-sm font-medium text-acento-600 dark:text-acento-300 mb-1">
            {coach?.emoji} {coach?.nombre} · {rutina.splitNombre}
          </p>
          <h1 class="text-2xl font-bold tracking-tight">{dia.etiqueta}</h1>
          <p class="text-sm mt-1 first-letter:uppercase" style="color: var(--texto-suave);">
            {fechaLegible}
          </p>
        </header>

        <nav class="flex gap-2 overflow-x-auto pb-2 mb-4" aria-label="Días de la rutina">
          {rutina.dias.map((_dia, i) => (
            <a
              href={`/rutina?dia=${i}`}
              aria-current={i === diaSugerido ? 'page' : undefined}
              class:list={[
                'shrink-0 min-h-11 inline-flex items-center px-4 rounded-xl border text-sm font-medium transition-colors',
                i === diaSugerido ? 'bg-acento-500 border-acento-500 text-white' : 'hover:border-acento-300',
              ]}
              style={i === diaSugerido ? '' : 'border-color: var(--borde); color: var(--texto-suave);'}
            >
              Día {i + 1}
            </a>
          ))}
        </nav>

        {
          dia.aviso && (
            <p
              class="text-sm rounded-lg px-3 py-2 border mb-4"
              style="border-color: var(--borde); background-color: var(--superficie-alt); color: var(--texto-suave);"
            >
              {dia.aviso}
            </p>
          )
        }

        <DiaEntreno
          date={hoy}
          dayIndex={diaSugerido}
          routineId={rutina._id ? String(rutina._id) : null}
          bloques={bloques}
          entradasIniciales={registro?.entries ?? []}
          sugerencias={sugerencias}
          client:load
        />
      </>
    )
  }
</Layout>
